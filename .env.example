# ==============================================================================
# RetailPulse Commercial Enterprise B2B SaaS - Production Configuration Template
# Copy this file to .env and replace placeholder values with your production secrets.
# ==============================================================================

# Core Application Settings
ENVIRONMENT=production
PORT=8000
DEBUG=false
APP_NAME=RetailPulse
APP_URL=https://app.retailpulse.ai

# Database Configuration (PostgreSQL 16 Recommended)
# For local SQLite dev, leave blank or set to: sqlite:///./retailpulse.db
DATABASE_URL=postgresql://retailpulse_admin:SuperSecretPostgresPass2026@localhost:5432/retailpulse_prod

# Redis Background Task Worker & Cache
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET=production_enterprise_jwt_secret_key_2026_change_this_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# E-Commerce Integrations - Shopify App Store
SHOPIFY_API_KEY=your_shopify_partner_app_api_key
SHOPIFY_API_SECRET=your_shopify_partner_app_api_secret
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_inventory,write_inventory
SHOPIFY_REDIRECT_URI=https://app.retailpulse.ai/api/integrations/shopify/callback

# E-Commerce Integrations - Amazon Seller Central (SP-API)
AMAZON_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxxxxxx
AMAZON_CLIENT_SECRET=amzn1.oa2-cs.v1.xxxxxxxxxxxx
AMAZON_REFRESH_TOKEN=Atzr|xxxxxxxxxxxx

# Billing & Payments - Razorpay (Unified India & Global UPI/Cards)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Billing & Payments - Stripe (Optional Global Alternative)
STRIPE_PUBLISHABLE_KEY=pk_live_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# Action Dispatchers - Automated Supplier Email Notifications (SendGrid / Postmark / SES)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_FROM_EMAIL=procurement@retailpulse.ai

# Automated Action Webhooks (Slack / Microsoft Teams)
SLACK_ALERTS_WEBHOOK_URL=https://example.com/webhooks/slack-sample

# Marketing Retention Automation - Klaviyo / Mailchimp
KLAVIYO_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxx
MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx-us1

# Observability & Exception Telemetry (Sentry)
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxx@o000000.ingest.sentry.io/0000000
